# --- Clerk (auth) ---
# Create a free app at https://dashboard.clerk.com
# Enable Email/Password sign-up, then Google, Facebook and Apple under
# "User & Authentication -> Social Connections" to match the reference flow.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Database (Prisma) ---
# Any Postgres works: local, Supabase, Neon, Railway, etc.
DATABASE_URL=postgresql://user:password@localhost:5432/recreate_studio

# --- Video generation provider ---
# "mock" works with zero setup and fakes a realistic render pipeline.
# Set to "fal" (or add your own) once you wire a real provider.
VIDEO_PROVIDER=mock
FAL_API_KEY=
